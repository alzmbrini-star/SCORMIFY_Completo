# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=scormify

# Local URLs and CORS
BASE_URL=http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Local storage and rendering
STORAGE_DIR=./storage
WHITEBOARD_OUTPUT_HEIGHT=720
WHITEBOARD_RENDER_TIMEOUT=600
WHITEBOARD_AI_PLAN_TIMEOUT_SECONDS=90
WHITEBOARD_AI_PLAN_CONCURRENCY=2
SKIP_SYSTEM_DEPS=false

# Optional integrations — leave blank to disable unavailable features
# Canonical text/vision provider. Keep EMERGENT_LLM_KEY only during the
# transition; new deployments need only OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_HTML_MODEL=gpt-4o
OPENAI_QUIZ_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_SECONDS=180
PDF_PAGE_RENDER_DPI=240
PDF_PAGE_MAX_DIMENSION=3200
ENABLE_PUBLIC_TUTOR=0
OPENAI_TUTOR_MODEL=gpt-5.6-luna
OPENAI_TUTOR_REASONING_EFFORT=low
OPENAI_TUTOR_MAX_OUTPUT_TOKENS=700
OPENAI_TUTOR_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=
CONVERTAPI_SECRET=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_MAX_VIDEO_BYTES=188743680
KREA_API_KEY=
LEONARDO_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
TUTORIAL_AGENT_URL=
TUTORIAL_AGENT_API_KEY=

# Optional multi-tenant migration fallback
DEFAULT_COMPANY_ID=
