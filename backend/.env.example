# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=scormify

# Local URLs and CORS
BASE_URL=http://localhost:8001
REACT_APP_BACKEND_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# Local storage and rendering
STORAGE_DIR=./storage
WHITEBOARD_OUTPUT_HEIGHT=720
WHITEBOARD_RENDER_TIMEOUT=600
SKIP_SYSTEM_DEPS=false

# Optional integrations — leave blank to disable unavailable features
# Prefer provider-specific project keys. Keep EMERGENT_LLM_KEY only as a
# compatibility fallback for older deployments.
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMERGENT_LLM_KEY=
CONVERTAPI_SECRET=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
HEYGEN_BASE_URL=https://api.heygen.com
KREA_API_KEY=
LEONARDO_API_KEY=
RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
TUTORIAL_AGENT_URL=
TUTORIAL_AGENT_API_KEY=

# Optional multi-tenant migration fallback
DEFAULT_COMPANY_ID=
