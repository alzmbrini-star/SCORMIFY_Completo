FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

COPY bootstrap-requirements.txt .
RUN pip install --no-cache-dir -r bootstrap-requirements.txt

COPY bootstrap_app.py .

EXPOSE 10000

CMD ["sh", "-c", "exec uvicorn bootstrap_app:app --host 0.0.0.0 --port ${PORT:-10000}"]
